{
  "name": "Free Food Map",
  "short_name": "Food Map",
  "description": "Find and help verify free food resources in your community.",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f6fa",
  "theme_color": "#001e44",
  "shortcuts": [
    {
      "name": "Search the map",
      "short_name": "Search",
      "url": "/#map",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Suggest a place",
      "short_name": "Suggest",
      "url": "/?suggest=1#map",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "share-title",
      "text": "share-text",
      "url": "share-url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
