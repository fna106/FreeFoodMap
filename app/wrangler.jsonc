{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "free-food-map",
  "account_id": "22240b4333a37692bcfbc78e59a4057e",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/locations/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "free-food-map-db",
      "database_id": "d79208af-6ad3-4f3c-b9dc-2e0b0578ae1e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *", "15 3 * * 1,4"]
  },
  "workflows": [
    {
      "binding": "VERIFY_WORKFLOW",
      "name": "free-food-map-verification",
      "class_name": "LocationVerificationWorkflow"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "freefoodmap.org/*",
      "zone_name": "freefoodmap.org"
    },
    {
      "pattern": "www.freefoodmap.org/*",
      "zone_name": "freefoodmap.org"
    }
  ]
}
